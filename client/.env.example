# Copy this file to .env and fill in the values. Never commit your real .env file.
# After editing .env, stop and restart "npm run dev".

# Supabase > Project Settings > API (use the "anon public" key, never service_role)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Address of the multiplayer server. Leave empty during local development.
# After deploying, set it to something like wss://your-app.fly.dev
VITE_SERVER_URL=

# An inbox you control, used to build hidden placeholder emails for accounts.
# Example: mygame.accounts@gmail.com  (use a separate, throwaway address, not your personal one)
VITE_PLACEHOLDER_EMAIL_BASE=
